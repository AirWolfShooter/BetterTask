<Window x:Class="BetterTask.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BetterTask"
        mc:Ignorable="d"
        Title="BetterTask"
        Height="510"
        Width="350"
        Background="#242424"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4444FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.90"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#9F0AC9" Offset="0.0"/>
                        <GradientStop Color="#2C2796" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0"
                Background="#1E1E1E"
                CornerRadius="5"
                Margin="0,0,0,10">

            <TextBlock Text="BetterTask"
                       FontSize="24"
                       FontFamily="Segoe UI"
                       FontWeight="UltraBold"
                       Foreground="WhiteSmoke"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Border>

        <Border Grid.Row="1"
                Background="#1E1E1E"
                CornerRadius="5"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="StatusTextBlock" Text="Waiting..." Foreground="WhiteSmoke" FontFamily="segoe ui" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10"/>
                <TextBlock x:Name="Timer" Text="00:00" Foreground="WhiteSmoke" FontFamily="segoe ui" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="Medium"/>
                <CheckBox x:Name="AutoSaveCheckBox" Content="Auto Save" Foreground="WhiteSmoke" FontFamily="segoe ui" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10"/>
            </StackPanel>

        </Border>


        <Border Grid.Row="2"
                Background="#1E1E1E"
                CornerRadius="5"
                Padding="10">

            <StackPanel>

                <Button x:Name="RecordButton"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="Record"
                        FontSize="20"
                        FontFamily="Segoe UI"
                        FontWeight="Medium"
                        Height="55"
                        Margin="0,0,0,15"
                        Click="recordingClicked"/>


                <Button x:Name="PlayBackButton"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="Play"
                        FontSize="20"
                        FontFamily="Segoe UI"
                        FontWeight="Medium"
                        Height="55"
                        Margin="0,0,0,15"/>


                <Button x:Name="SaveButton"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="Save Recording"
                        FontSize="20"
                        FontFamily="Segoe UI"
                        FontWeight="Medium"
                        Height="55"
                        Margin="0,0,0,15"/>
                <Button x:Name="SettingsButton"
                        Style="{StaticResource RoundedButtonStyle}"
                        FontFamily="Segoe UI"
                        FontSize="20"
                        FontWeight="Medium"
                        Height="55"
                        Content="Settings"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>