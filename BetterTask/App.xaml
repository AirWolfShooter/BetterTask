             xmlns:local="clr-namespace:BetterTask"
             ShutdownMode="OnMainWindowClose"
             StartupUri="Interface/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Interface/Style/ButtonStyle.xaml"/>
                <ResourceDictionary Source="Interface/Style/RoundedCheckBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
