<Window x:Class="BetterTask.Interface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BetterTask.Interface"
        mc:Ignorable="d"
        Title="BetterTask"
        Height="550"
        Width="350"
        Background="#242424"
        ResizeMode="NoResize">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0"
                Background="#1E1E1E"
                CornerRadius="5"
                Margin="0,0,0,10">

            <TextBlock Text="BetterTask"
                       FontSize="24"
                       FontFamily="Segoe UI"
                       FontWeight="UltraBold"
                       Foreground="WhiteSmoke"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Border>

        <Border Grid.Row="1"
                Background="#1E1E1E"
                CornerRadius="5"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="StatusTextBlock" Text="Waiting..." Foreground="WhiteSmoke" FontFamily="segoe ui" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10"/>
                <TextBlock x:Name="Timer" Text="00:00" Foreground="WhiteSmoke" FontFamily="segoe ui" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="Medium"/>
            </StackPanel>

        </Border>


        <Border Grid.Row="2"
                Background="#1E1E1E"
                CornerRadius="5"
                Padding="10">

            <StackPanel x:Name="ButtonStackPanel">

                <Button x:Name="RecordButton"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="Record"
                        FontSize="20"
                        Height="55"
                        Margin="0,0,0,15"
                        Click="recordingClicked"/>


                <Button x:Name="PlayBackButton"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="Play"
                        FontSize="20"
                        Height="55"
                        Margin="0,0,0,15"
                        Click="playbackClicked"/>


                <Button x:Name="SaveButton"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="Save Recording"
                        FontSize="20"
                        Height="55"
                        Margin="0,0,0,15"
                        Click="saveButtonClicked"/>
                
                <Button x:Name="LoadButton"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="Load Recording"
                        FontSize="20"
                        Height="55"
                        Margin="0,0,0,15"
                        Click="loadButtonClicked"/>
                
                <Button x:Name="SettingsButton"
                        Style="{StaticResource RoundedButtonStyle}"
                        FontSize="20"
                        Height="55"
                        Content="Settings"
                        Click="settingsButtonClicked"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>