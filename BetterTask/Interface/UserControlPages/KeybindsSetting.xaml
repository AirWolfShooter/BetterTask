<UserControl x:Class="BetterTask.Interface.UserControlPages.KeybindsSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BetterTask.Interface.UserControlPages"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <StackPanel Margin="15">

        <TextBlock Text="Keybind Settings"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,20"/>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                <TextBlock Text="Start / Stop Recording"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <Button x:Name="RecordHotkeyButton"
                        Content="None"
                        Height="35"
                        Tag="Recording"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="SetKey"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                <TextBlock Text="Playback"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <Button x:Name="PlaybackHotkeyButton"
                        Content="None"
                        Height="35"
                        Tag="Playback"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="SetKey"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                <TextBlock Text="Stop Playback"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <Button x:Name="StopPlaybackHotkeyButton"
                        Content="None"
                        Height="35"
                        Tag="StopPlayback"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="SetKey"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                <TextBlock Text="Pause Playback"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <Button x:Name="PausePlaybackHotkeyButton"
                        Content="None"
                        Height="35"
                        Tag="PausePlayback"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="SetKey"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Margin="5">
                <TextBlock Text="Resume Playback"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <Button x:Name="ResumePlaybackHotkeyButton"
                        Content="None"
                        Height="35"
                        Tag="ResumePlayback"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="SetKey"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="1" Margin="5">
                
                <TextBlock Text="Loop Playback"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                
                <Button x:Name="LoopPlaybackHotkeyButton"
                        Content="None"
                        Height="35"
                        Tag="LoopPlayback"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="SetKey"/>
                
            </StackPanel>

        </Grid>

    </StackPanel>

</UserControl>