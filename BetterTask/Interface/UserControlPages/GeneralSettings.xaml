<UserControl x:Class="BetterTask.Interface.UserControlPages.GeneralSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <StackPanel Margin="15">

        <TextBlock Text="General Settings"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,20"/>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox x:Name="stayOnTop"
                      Grid.Row="0"
                      Grid.Column="0"
                      Style="{StaticResource RoundedCheckBox}"
                      Content="Stay on top"
                      Foreground="White"
                      Margin="5"
                      Click="stayOnTopClicked"/>

            <CheckBox x:Name="checkForUpdates"
                      Grid.Row="0"
                      Grid.Column="1"
                      Style="{StaticResource RoundedCheckBox}"
                      Content="Check for Updates"
                      Foreground="White"
                      Margin="5"
                      Click="checkForUpdatesClicked"/>

            <CheckBox x:Name="saveAutomatically"
                      Grid.Row="2"
                      Grid.Column="0"
                      Style="{StaticResource RoundedCheckBox}"
                      Content="Save Automatically"
                      Foreground="White"
                      Margin="5"
                      Click="saveAutoClicked"/>

            <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"
                        HorizontalAlignment="Center">

                <TextBlock Text="Start Delay (ms)"
                           Foreground="#BFBFBF"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <Border Background="#2A2A2A"
                        BorderBrush="#444444"
                        BorderThickness="1"
                        CornerRadius="8">

                    <TextBox x:Name="startDelay"
                             PreviewTextInput="TextBlock_PreviewTextInput"
                             TextChanged="startDelay_TextChanged"
                             Width="100"
                             Height="34"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="White"
                             FontSize="14"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="8,0"/>
                </Border>

            </StackPanel>

            <StackPanel Grid.Row="4">
                <TextBlock x:Name="loadSettings"
                           Text="Load New Settings"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontWeight="Medium"
                           Height="20"
                           Margin="0,0,0,5"/>

                <Button x:Name="loadSettingsButton"
                        Content="Choose Settings Folder"
                        Width="250"
                        Height="50"
                        HorizontalAlignment="Center"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="loadSettingsClicked"/>
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Grid.Column="1">

                <TextBlock x:Name="saveSettings"
                           Text="Save Settings"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontWeight="Medium"
                           Height="20"
                           Margin="0,0,0,5"/>

                <Button x:Name="saveSettingsButton"
                        Content="Save Settings"
                        Width="250"
                        Height="50"
                        HorizontalAlignment="Center"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="saveSettingsClicked"/>

            </StackPanel>

        </Grid>

        <StackPanel Margin="0,20,0,0">

            <TextBlock x:Name="exportSettings"
                       Text="Export Settings"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontWeight="Medium"
                       Height="20"
                       Margin="0,0,0,5"/>

            <Button x:Name="exportSettingsButton"
                    Content="Export Settings"
                    Width="250"
                    Height="50"
                    HorizontalAlignment="Center"
                    Style="{StaticResource RoundedButtonStyle}"
                    Click="exportSettingsClicked"/>

        </StackPanel>

    </StackPanel>

</UserControl>