<Window x:Class="BetterTask.Interface.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BetterTask.Interface"
        mc:Ignorable="d"
        Title="Settings"
        Height="450"
        Width="800"
        Background="#242424"
        ResizeMode="NoResize">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#1E1E1E"
                CornerRadius="5"
                Margin="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button x:Name="GeneralButton"
                    Content="General"
                    Margin="5"
                    Height="40"
                    VerticalAlignment="Top"
                    Style="{StaticResource RoundedButtonStyle}"
                    Click="GeneralSettingsClick"/>
                    
                    <Button x:Name="KeybindsButton"
                    Content="Keybinds"
                    Margin="5"
                    Height="40"
                    VerticalAlignment="Top"
                    Style="{StaticResource RoundedButtonStyle}"
                    Click="KeybindsSettingsClick"/>
                </StackPanel>
            </ScrollViewer>

        </Border>

        <Rectangle Grid.Column="1"
                   Fill="White"
                   Width="2"
                   HorizontalAlignment="Center"/>

        <Border Grid.Column="2"
                Background="#1E1E1E"
                CornerRadius="5"
                Margin="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="ShownContent"/>
            </ScrollViewer>
        </Border>


    </Grid>

</Window>