<Window x:Class="BetterTask.Interface.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterTask" Height="600" Width="420" Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/BetterTask.ico" CanResize="False" WindowStartupLocation="CenterScreen">
    <Grid>
        <Image x:Name="ThemeBackgroundImage" Stretch="UniformToFill" Opacity="0.3"
               IsVisible="False" IsHitTestVisible="False" />
        <Grid x:Name="RootGrid" Margin="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="18">
        <Grid x:Name="HeaderPanel" Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12"
              VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border x:Name="BrandBadge" Width="48" Height="48" CornerRadius="15"
                        Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="B" FontSize="25" FontWeight="Bold"
                               Foreground="{DynamicResource AccentHoverBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="HeaderTitle" Text="BetterTask" FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="HeaderSubtitle" Text="Desktop macro recorder" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="CompactToggleButton" Grid.Column="1" Content="Compact" Width="86"
                    Height="36" FontSize="12" Theme="{StaticResource SecondaryButtonStyle}"
                    Click="ToggleCompactModeClicked" />
        </Grid>

        <Border x:Name="SessionCard" Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                CornerRadius="16" Padding="18">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="CURRENT SESSION" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="StatusTextBlock" Text="Waiting..." FontSize="18"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Spacing="4">
                    <TextBlock Text="ELAPSED" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" />
                    <TextBlock x:Name="Timer" Text="00:00" FontSize="30"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel x:Name="QuickActionsPanel" Grid.Row="2" Spacing="12">
            <TextBlock x:Name="QuickActionsLabel" Text="QUICK ACTIONS" FontSize="11"
                       FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="2,0,0,0" />
            <StackPanel x:Name="ButtonStackPanel" Spacing="10">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="10" RowSpacing="6">
                    <Button x:Name="RecordButton" Theme="{StaticResource RoundedButtonStyle}"
                            Content="Record" FontSize="16" Height="62"
                            Click="recordingClicked" />
                    <Button x:Name="PlayBackButton" Grid.Column="1"
                            Theme="{StaticResource SecondaryButtonStyle}" Content="Play"
                            FontSize="16" Height="62" Click="playbackClicked" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Spacing="6">
                        <Button x:Name="AppendRecordingButton" Content="Append segment"
                                Width="136" Height="32" FontSize="11" IsVisible="False"
                                Theme="{StaticResource SecondaryButtonStyle}"
                                Click="appendRecordingClicked" />
                        <Button x:Name="UndoAppendButton" Content="Undo append"
                                Width="100" Height="32" FontSize="11" IsVisible="False"
                                Theme="{StaticResource SecondaryButtonStyle}"
                                Click="undoAppendClicked" />
                        <Button x:Name="PauseRecordingButton" Content="Pause recording"
                                Width="112" Height="32" FontSize="11" IsVisible="False"
                                Theme="{StaticResource SecondaryButtonStyle}"
                                Click="pauseRecordingClicked" />
                        <Button x:Name="ResumeRecordingButton" Content="Resume recording"
                                Width="112" Height="32" FontSize="11" IsVisible="False"
                                Theme="{StaticResource SecondaryButtonStyle}"
                                Click="resumeRecordingClicked" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="SecondaryActions" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button x:Name="MacroManagerButton" Theme="{StaticResource SecondaryButtonStyle}"
                            Content="Macro Library" Height="48" Click="macroManagerClicked" />
                    <Button x:Name="SettingsButton" Grid.Column="1"
                            Theme="{StaticResource SecondaryButtonStyle}"
                            Content="Settings" Height="48" Click="settingsButtonClicked" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <Border x:Name="Footer" Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                CornerRadius="14" Padding="14" VerticalAlignment="Bottom">
            <TextBlock Text="Record a sequence, then replay it whenever you need it."
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </Border>
        </Grid>
    </Grid>
</Window>
